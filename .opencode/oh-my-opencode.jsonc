      "description": "Research Assistant - Fast assistant tasks"
    },
    "multimodal-looker": {
      "model": "bailian-coding-plan/kimi-k2.5",
      "fallback_models": ["bailian-coding-plan/qwen3.5-plus"],
      "thinking": { "type": "enabled", "budgetTokens": 8192 },
      "description": "Visual Analyst - Image analysis with text+image input"
    }
  },

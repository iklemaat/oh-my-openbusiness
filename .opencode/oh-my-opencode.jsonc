{
  "$schema": "https://opencode.ai/config.json",
  "model_fallback": true,
  "new_task_system_enabled": true,
  "agents": {
    "sisyphus": {
      "model": "bailian-coding-plan/qwen3.5-plus",
      "fallback_models": ["bailian-coding-plan/glm-5"],
      "thinking": { "type": "enabled", "budgetTokens": 8192 },
      "description": "Research Director - Main orchestrator for UX research with 1M context + vision"
    },
    "hephaestus": {
      "model": "bailian-coding-plan/glm-5",
      "fallback_models": ["bailian-coding-plan/glm-4.7"],
      "thinking": { "type": "enabled", "budgetTokens": 8192 },
      "allow_non_gpt_model": true,
      "description": "Deep Researcher - Autonomous research with reasoning"
    },
    "oracle": {
      "model": "bailian-coding-plan/qwen3.5-plus",
      "fallback_models": ["bailian-coding-plan/glm-5"],
      "thinking": { "type": "enabled", "budgetTokens": 8192 },
      "description": "Insight Analyst - Complex synthesis with max capability"
    },
    "librarian": {
      "model": "bailian-coding-plan/qwen3.5-plus",
      "fallback_models": ["bailian-coding-plan/glm-5"],
      "description": "Industry Researcher - 1M context for large documents and reports"
    },
    "explore": {
      "model": "bailian-coding-plan/glm-5",
      "fallback_models": ["bailian-coding-plan/glm-4.7"],
      "thinking": { "type": "enabled", "budgetTokens": 8192 },
      "description": "Web Scout - Strong reasoning for pattern detection"
    },
    "atlas": {
      "model": "bailian-coding-plan/qwen3.5-plus",
      "fallback_models": ["bailian-coding-plan/glm-5"],
      "thinking": { "type": "enabled", "budgetTokens": 8192 },
      "description": "Master Orchestrator - Full context coordination with max capability"
    },
    "prometheus": {
      "model": "bailian-coding-plan/qwen3.5-plus",
      "fallback_models": ["bailian-coding-plan/glm-5"],

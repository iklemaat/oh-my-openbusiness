{
  "$schema": "https://opencode.ai/config.json",

  // Balanced defaults for general UX research.
  // Tuned for reliability across diverse research tasks without overspending.

  "provider": {
    "bailian-coding-plan": {
      "npm": "@ai-sdk/anthropic",
      "name": "Model Studio Coding Plan",
      "options": {
        "baseURL": "https://coding-intl.dashscope.aliyuncs.com/apps/anthropic/v1",
        "apiKey": "YOUR_API_KEY"
      },
      "models": {
        "qwen3.5-plus": {
          "name": "Qwen3.5 Plus",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "options": { "thinking": { "type": "enabled", "budgetTokens": 8192 } },
          "limit": { "context": 1000000, "output": 65536 }
        },
        "glm-5": {
          "name": "GLM-5",
          "modalities": { "input": ["text"], "output": ["text"] },
          "options": { "thinking": { "type": "enabled", "budgetTokens": 8192 } },
          "limit": { "context": 202752, "output": 16384 }
        },
        "kimi-k2.5": {
          "name": "Kimi K2.5",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "options": { "thinking": { "type": "enabled", "budgetTokens": 8192 } },
          "limit": { "context": 262144, "output": 32768 }
        },
        "MiniMax-M2.5": {
          "name": "MiniMax M2.5",
          "modalities": { "input": ["text"], "output": ["text"] },
          "options": { "thinking": { "type": "enabled", "budgetTokens": 8192 } },
          "limit": { "context": 196608, "output": 24576 }
        }
      }
    }
  },

  "agents": {
    // Main orchestrator: handles delegation and drives research to completion
    "sisyphus": {
      "model": "bailian-coding-plan/qwen3.5-plus",
      "thinking": { "type": "enabled", "budgetTokens": 8192 },
    },

    // Deep autonomous researcher: end-to-end research
    "hephaestus": {
      "model": "bailian-coding-plan/glm-5",
      "thinking": { "type": "enabled", "budgetTokens": 8192 },
      "prompt_append": "Explore sources thoroughly, then synthesize findings. Prefer evidence-backed claims with direct quotes.",
    },

    // Strategic planner: interview mode before research
    "prometheus": {
      "model": "bailian-coding-plan/qwen3.5-plus",
      "thinking": { "type": "enabled", "budgetTokens": 8192 },
      "prompt_append": "Always interview first. Validate research scope before planning.",
    },

    // Insight consultant: complex synthesis and pattern analysis
    "oracle": { "model": "bailian-coding-plan/qwen3.5-plus", "thinking": { "type": "enabled", "budgetTokens": 8192 } },

    // Industry benchmarks and reports
    "librarian": { "model": "bailian-coding-plan/qwen3.5-plus" },

    // Web and social media scouting
    "explore": { "model": "bailian-coding-plan/glm-5" },

    // Visual UX analysis
    "multimodal-looker": { "model": "bailian-coding-plan/kimi-k2.5" },

    // Research optimization
    "metis": { "model": "bailian-coding-plan/glm-5" },

    // Research plan review
    "momus": { "model": "bailian-coding-plan/glm-4.7" },

    // Long-running research sessions
    "atlas": {},

    // Lightweight research assistant for simple tasks
    "sisyphus-junior": { "model": "bailian-coding-plan/MiniMax-M2.5" },
  },

  "categories": {
    "quick-lookup": { "model": "bailian-coding-plan/MiniMax-M2.5" },
    "content-coding": { "model": "bailian-coding-plan/glm-5" },
    "report-writing": { "model": "bailian-coding-plan/kimi-k2.5" },
    "visual-audit": { "model": "bailian-coding-plan/kimi-k2.5" },
    "deep-research": { "model": "bailian-coding-plan/kimi-k2.5" },
    "thematic-analysis": { "model": "bailian-coding-plan/glm-5" },
    "comprehensive-study": { "model": "bailian-coding-plan/qwen3.5-plus" },
    "creative-insights": { "model": "bailian-coding-plan/qwen3.5-plus" },
  },

  // Conservative concurrency for cost control
  "background_task": {
    "providerConcurrency": {
      "bailian-coding-plan": 5,
    },
  },

  "experimental": { "task_system": true },
}

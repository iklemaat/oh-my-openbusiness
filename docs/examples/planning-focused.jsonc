{
  "$schema": "https://opencode.ai/config.json",

  // Optimized for strategic research planning and complex study design.
  // Prioritizes deep thinking agents and thorough analysis before research execution.

  "provider": {
    "bailian-coding-plan": {
      "npm": "@ai-sdk/anthropic",
      "name": "Model Studio Coding Plan",
      "options": {
        "baseURL": "https://coding-intl.dashscope.aliyuncs.com/apps/anthropic/v1",
        "apiKey": "YOUR_API_KEY"
      }
    }
  },

  "agents": {
    // Orchestrator: delegates to planning agents first
    "sisyphus": {
      "model": "bailian-coding-plan/qwen3.5-plus",
      "thinking": { "type": "enabled", "budgetTokens": 8192 },
      "prompt_append": "Always consult prometheus and atlas for research planning. Never rush to execution.",
    },

    // Implementation: uses research plan outputs
    "hephaestus": {
      "model": "bailian-coding-plan/glm-5",
      "thinking": { "type": "enabled", "budgetTokens": 8192 },
      "prompt_append": "Follow established research plans precisely. Ask for clarification when plans are ambiguous.",
    },

    // Primary planner: deep interview mode
    "prometheus": {
      "model": "bailian-coding-plan/qwen3.5-plus",
      "thinking": { "type": "enabled", "budgetTokens": 8192 },
      "prompt_append": "Interview extensively. Question research assumptions. Build exhaustive plans with milestones, risks, and contingencies. Use deep & quick agents heavily in parallel for source research.",
    },

    // Insight consultant
    "oracle": {
      "model": "bailian-coding-plan/qwen3.5-plus",
      "thinking": { "type": "enabled", "budgetTokens": 8192 },
    },

    // Industry research and benchmarks
    "librarian": { "model": "bailian-coding-plan/qwen3.5-plus" },

    // Exploration for research phase
    "explore": { "model": "bailian-coding-plan/glm-5" },

    // Visual research and analysis
    "multimodal-looker": { "model": "bailian-coding-plan/kimi-k2.5" },

    // Plan review and refinement: heavily utilized
    "metis": {
      "model": "bailian-coding-plan/glm-5",
      "prompt_append": "Critically evaluate research plans. Identify gaps, risks, and improvements. Be thorough.",
    },

    // Critic: challenges research assumptions
    "momus": {
      "model": "bailian-coding-plan/glm-4.7",
      "prompt_append": "Challenge all assumptions in research plans. Look for edge cases, failure modes, and overlooked user segments.",
    },

    // Long-running research sessions
    "atlas": {
      "prompt_append": "Preserve context across long research sessions. Track evolving research decisions.",
    },

    // Quick research tasks
    "sisyphus-junior": { "model": "bailian-coding-plan/MiniMax-M2.5" },
  },

  "categories": {
    "quick-lookup": { "model": "bailian-coding-plan/MiniMax-M2.5" },

    "content-coding": { "model": "bailian-coding-plan/glm-5" },

    // High-effort research tasks: maximum reasoning
    "comprehensive-study": {
      "model": "bailian-coding-plan/qwen3.5-plus",
    },

    // Research documentation
    "report-writing": { "model": "bailian-coding-plan/kimi-k2.5" },

    // Visual research
    "visual-audit": { "model": "bailian-coding-plan/kimi-k2.5" },

    // Deep research and analysis
    "deep-research": { "model": "bailian-coding-plan/kimi-k2.5" },

    // Strategic research reasoning
    "thematic-analysis": { "model": "bailian-coding-plan/glm-5" },

    // Creative research approaches
    "creative-insights": { "model": "bailian-coding-plan/qwen3.5-plus" },
  },

  // Moderate concurrency: research planning is sequential by nature
  "background_task": {
    "defaultConcurrency": 5,
    "staleTimeoutMs": 300000,
    "providerConcurrency": {
      "bailian-coding-plan": 5,
    },
    "modelConcurrency": {
      "bailian-coding-plan/qwen3.5-plus": 2,
      "bailian-coding-plan/glm-5": 2,
    },
  },

  "sisyphus_agent": {
    "planner_enabled": true,
    "replace_plan": true,
  },

  "experimental": { "task_system": true },
}

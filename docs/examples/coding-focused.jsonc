{
  "$schema": "https://opencode.ai/config.json",

  // Optimized for intensive UX research sessions.
  // Prioritizes deep research agents and fast source scanning.

  "agents": {
    // Primary orchestrator: aggressive parallel delegation
    "sisyphus": {
      "model": "bailian-coding-plan/qwen3.5-plus",
      "thinking": { "type": "enabled", "budgetTokens": 8192 },
      "prompt_append": "Delegate heavily to hephaestus for deep research. Parallelize source exploration.",
    },

    // Heavy lifter: maximum autonomy for research
    "hephaestus": {
      "model": "bailian-coding-plan/glm-5",
      "thinking": { "type": "enabled", "budgetTokens": 8192 },
      "prompt_append": "You are the primary research agent. Own the research. Explore sources, extract findings, synthesize. Use web search, social listening, and review mining aggressively.",
    },

    // Research planner: thorough planning
    "prometheus": {
      "model": "bailian-coding-plan/qwen3.5-plus",
      "thinking": { "type": "enabled", "budgetTokens": 8192 },
      "prompt_append": "Keep plans thorough. Focus on source diversity, research waves, and evidence standards.",
    },

    // Insight synthesis
    "oracle": { "model": "bailian-coding-plan/qwen3.5-plus", "thinking": { "type": "enabled", "budgetTokens": 8192 } },

    // Industry benchmarks
    "librarian": { "model": "bailian-coding-plan/qwen3.5-plus" },

    // Web and social media scouting
    "explore": { "model": "bailian-coding-plan/glm-5" },

    // Visual UX analysis
    "multimodal-looker": { "model": "bailian-coding-plan/kimi-k2.5" },

    // Research optimization
    "metis": { "model": "bailian-coding-plan/glm-5" },

    // Research plan review
    "momus": { "model": "bailian-coding-plan/glm-4.7", "prompt_append": "Focus on research quality, evidence triangulation, and source diversity." },

    // Long-running research sessions
    "atlas": {},

    // Quick lookups and simple research
    "sisyphus-junior": { "model": "bailian-coding-plan/MiniMax-M2.5" },
  },

  "categories": {
    // Trivial lookups: fastest possible
    "quick-lookup": { "model": "bailian-coding-plan/MiniMax-M2.5" },

    // Standard research: good quality, fast
    "content-coding": { "model": "bailian-coding-plan/glm-5" },

    // Complex synthesis: best quality
    "comprehensive-study": { "model": "bailian-coding-plan/qwen3.5-plus" },

    // Visual work
    "visual-audit": { "model": "bailian-coding-plan/kimi-k2.5", "thinking": { "type": "enabled", "budgetTokens": 8192 } },

    // Deep autonomous research
    "deep-research": { "model": "bailian-coding-plan/kimi-k2.5" },

    // Research decisions
    "thematic-analysis": { "model": "bailian-coding-plan/glm-5" },
  },

  // High concurrency for parallel research work
  "background_task": {
    "defaultConcurrency": 8,
    "providerConcurrency": {
      "bailian-coding-plan": 10,
    },
  },

  // Enable research aids
  "experimental": { "task_system": true },
}
